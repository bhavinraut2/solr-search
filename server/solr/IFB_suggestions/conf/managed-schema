<?xml version="1.0" encoding="UTF-8" ?>
<!--
 Solr Schema for Autocomplete Suggestions
 Core: default_suggestions
 Optimized for fast prefix matching with minimal overhead
-->
<schema name="default-suggestions" version="1.6">
  
  <!-- ===========================
       FIELD DEFINITIONS
       =========================== -->
  
  <!-- Primary key -->
  <field name="id" type="string" indexed="true" stored="true" required="true" multiValued="false" />
  
  <!-- Version field for optimistic concurrency -->
  <field name="_version_" type="plong" indexed="false" stored="false"/>
  
  <!-- Main suggestion text - analyzed with edgeNGram for prefix matching -->
  <field name="suggest_text" type="text_autocomplete" indexed="true" stored="true" required="true" />
  
  <!-- Fuzzy search field - for typo tolerance -->
  <field name="suggest_text_fuzzy" type="text_fuzzy" indexed="true" stored="false" />
  
  <!-- Type categorization (e.g., product, category, brand) -->
  <field name="type" type="string" indexed="true" stored="true" />
  
  <!-- Weight for ranking/sorting suggestions -->
  <field name="weight" type="pint" indexed="true" stored="true" required="true" />
  
  <!-- Catch-all text field for general search -->
  <field name="text" type="text_general" indexed="true" stored="false" multiValued="true"/>
  
  <!-- Copy suggest_text to fuzzy and text fields -->
  <copyField source="suggest_text" dest="suggest_text_fuzzy"/>
  <copyField source="suggest_text" dest="text"/>
  
  <!-- ===========================
       UNIQUE KEY
       =========================== -->
  <uniqueKey>id</uniqueKey>

  <!-- ===========================
       FIELD TYPE DEFINITIONS
       =========================== -->
  
  <!-- String type for exact matching -->
  <fieldType name="string" class="solr.StrField" sortMissingLast="true" docValues="true" />
  
  <!-- Integer type for weight scoring -->
  <fieldType name="pint" class="solr.IntPointField" docValues="true"/>
  
  <!-- Long type for version field -->
  <fieldType name="plong" class="solr.LongPointField" docValues="true"/>
  
  <!-- Autocomplete field type with edgeNGram for prefix matching -->
  <fieldType name="text_autocomplete" class="solr.TextField" positionIncrementGap="100">
    <analyzer type="index">
      <tokenizer class="solr.StandardTokenizerFactory"/>
      <filter class="solr.LowerCaseFilterFactory"/>
      <filter class="solr.StopFilterFactory" words="stopwords.txt" ignoreCase="true"/>
      <filter class="solr.EdgeNGramFilterFactory" minGramSize="1" maxGramSize="20"/>
    </analyzer>
    <analyzer type="query">
      <tokenizer class="solr.StandardTokenizerFactory"/>
      <filter class="solr.LowerCaseFilterFactory"/>
      <filter class="solr.StopFilterFactory" words="stopwords.txt" ignoreCase="true"/>
    </analyzer>
  </fieldType>
  
  <!-- Fuzzy matching field type with NGram (for typo tolerance) -->
  <fieldType name="text_fuzzy" class="solr.TextField" positionIncrementGap="100">
    <analyzer type="index">
      <tokenizer class="solr.StandardTokenizerFactory"/>
      <filter class="solr.LowerCaseFilterFactory"/>
      <filter class="solr.ASCIIFoldingFilterFactory"/>
      <filter class="solr.NGramFilterFactory" minGramSize="2" maxGramSize="15"/>
    </analyzer>
    <analyzer type="query">
      <tokenizer class="solr.StandardTokenizerFactory"/>
      <filter class="solr.LowerCaseFilterFactory"/>
      <filter class="solr.ASCIIFoldingFilterFactory"/>
      <filter class="solr.NGramFilterFactory" minGramSize="2" maxGramSize="15"/>
    </analyzer>
  </fieldType>
  
  <!-- General text field type for basic text search -->
  <fieldType name="text_general" class="solr.TextField" positionIncrementGap="100">
    <analyzer type="index">
      <tokenizer class="solr.StandardTokenizerFactory"/>
      <filter class="solr.StopFilterFactory" ignoreCase="true" words="stopwords.txt" />
      <filter class="solr.LowerCaseFilterFactory"/>
    </analyzer>
    <analyzer type="query">
      <tokenizer class="solr.StandardTokenizerFactory"/>
      <filter class="solr.StopFilterFactory" ignoreCase="true" words="stopwords.txt" />
      <filter class="solr.LowerCaseFilterFactory"/>
    </analyzer>
  </fieldType>

</schema>
